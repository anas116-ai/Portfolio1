# Copy to .env.local and fill in. .env*.local is gitignored.

# Context.dev — one key for web data: scraping, crawling, web search, structured
# extraction, brand intelligence, file parsing, change monitoring.
# Base URL: https://api.context.dev/v1   Docs: https://docs.context.dev
# Every request sends `Authorization: Bearer $CONTEXT_DEV_API_KEY`.
# The SDK reads this variable automatically. Rotate at
# https://www.context.dev/dashboard/api-keys
CONTEXT_DEV_API_KEY=ctxt_secret_...

# The /studio reference extractor spends credits (a styleguide read is 10).
# It is owner-only by default — it answers only when NODE_ENV !== "production".
# Set to 1 to allow it from a production build too.
STUDIO_REFERENCE_PUBLIC=0
